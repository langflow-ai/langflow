{
  "__inputs": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus"}],
  "uid": "langflow-trigger-governance",
  "title": "Langflow trigger delivery and renewal",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["langflow", "triggers"],
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [{"name": "job", "label": "Deployment scrape job", "type": "query", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "query": "label_values(langflow_trigger_events, job)", "refresh": 1, "multi": false, "includeAll": false}]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Canonical source cohort by outcome", "description": "Counts of retained source events accepted within the configured collection window. Skipped events are shown separately; hints, tests, and replays are excluded.", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"refId": "A", "expr": "max by (state) (langflow_trigger_events{job=\"$job\",origin=\"source\"})", "legendFormat": "{{state}}"}]},
    {"id": 2, "type": "timeseries", "title": "Accepted source events completed (%)", "description": "The current accepted cohort includes events still waiting or running. A zero denominator is no data, not success. This does not measure events lost before intake.", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}}, "targets": [{"refId": "A", "expr": "100 * max(langflow_trigger_events{job=\"$job\",origin=\"source\",state=\"completed\"}) / sum(max by (state) (langflow_trigger_events{job=\"$job\",origin=\"source\",state!=\"skipped\"}))", "legendFormat": "completed"}]},
    {"id": 3, "type": "timeseries", "title": "Acceptance to first run start", "description": "Per-cohort p50/p95 over retained first run_started observations. Compare with sample and missing-evidence counts below.", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"refId": "A", "expr": "max(langflow_trigger_dispatch_latency_p50_seconds{job=\"$job\"})", "legendFormat": "p50"}, {"refId": "B", "expr": "max(langflow_trigger_dispatch_latency_p95_seconds{job=\"$job\"})", "legendFormat": "p95"}, {"refId": "C", "expr": "max(langflow_trigger_oldest_pending_seconds{job=\"$job\"})", "legendFormat": "oldest pending"}]},
    {"id": 4, "type": "timeseries", "title": "Renewal results and observed gaps", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "targets": [{"refId": "A", "expr": "max by (outcome) (langflow_trigger_renewals{job=\"$job\"})", "legendFormat": "{{outcome}}"}, {"refId": "B", "expr": "max(langflow_trigger_renewals_with_gap{job=\"$job\"})", "legendFormat": "renewed after expiry"}, {"refId": "C", "expr": "max(langflow_trigger_expired_subscriptions{job=\"$job\"})", "legendFormat": "currently expired, not retired"}]},
    {"id": 5, "type": "timeseries", "title": "First-start evidence coverage", "description": "Missing starts can be jobs still queued or purged history. They are not treated as zero-latency runs.", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 7, "w": 12, "x": 0, "y": 16}, "targets": [{"refId": "A", "expr": "max(langflow_trigger_dispatch_latency_samples{job=\"$job\"})", "legendFormat": "known starts"}, {"refId": "B", "expr": "max(langflow_trigger_missing_first_starts{job=\"$job\"})", "legendFormat": "missing starts"}]},
    {"id": 6, "type": "timeseries", "title": "Recovered renewal coverage gap", "description": "Sum of observed expiry-to-success gaps for renewals completed in the collection window. Provider delivery must still be tested across renewal.", "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "gridPos": {"h": 7, "w": 12, "x": 12, "y": 16}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"refId": "A", "expr": "max(langflow_trigger_renewal_gap_seconds{job=\"$job\"})", "legendFormat": "observed recovered gap"}]}
  ]
}
