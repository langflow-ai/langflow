{
  "description": "Repair: repair_flow_data(flow, base). A case gives `flow` (or `flow_json`) and an optional `base`, and either the repaired graph with the fixes in the order repair made them, or the error with the violations only the client can fix. Generated node ids are derived from content, so they are exact; edge and row ids are random, so they appear as `<generated edge id>` and `<generated row id>`. Each case names the rule it checks in `rule`; README.md lists the rules. The expected outputs are reviewed data that every engine must meet.",
  "cases": [
    {
      "name": "a valid graph is returned unchanged with no fixes",
      "rule": "repair-direct-only",
      "flow": {
        "nodes": [
          {"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}},
          {"id": "b", "data": {"id": "b", "type": "Prompt", "node": {"template": {}}}}
        ],
        "edges": [{"id": "e", "source": "a", "target": "b", "sourceHandle": "S", "targetHandle": "T"}],
        "viewport": {"zoom": 1}
      },
      "expected": {
        "nodes": [
          {"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}},
          {"id": "b", "data": {"id": "b", "type": "Prompt", "node": {"template": {}}}}
        ],
        "edges": [{"id": "e", "source": "a", "target": "b", "sourceHandle": "S", "targetHandle": "T"}],
        "viewport": {"zoom": 1}
      },
      "fixes": []
    },
    {
      "name": "flow data null becomes an empty flow",
      "rule": "graph-structure",
      "flow": null,
      "expected": {"nodes": [], "edges": []},
      "fixes": [{"code": "FLOW_DATA_NOT_OBJECT", "path": [], "action": "replaced with an empty flow"}]
    },
    {
      "name": "flow data that is a list becomes an empty flow",
      "rule": "graph-structure",
      "flow": [],
      "expected": {"nodes": [], "edges": []},
      "fixes": [{"code": "FLOW_DATA_NOT_OBJECT", "path": [], "action": "replaced with an empty flow"}]
    },
    {
      "name": "flow data that is a string becomes an empty flow",
      "rule": "graph-structure",
      "flow": "x",
      "expected": {"nodes": [], "edges": []},
      "fixes": [{"code": "FLOW_DATA_NOT_OBJECT", "path": [], "action": "replaced with an empty flow"}]
    },
    {
      "name": "non-list collections become empty lists",
      "rule": "graph-structure",
      "flow": {"nodes": null, "edges": "x", "description": "kept"},
      "expected": {"nodes": [], "edges": [], "description": "kept"},
      "fixes": [
        {"code": "COLLECTION_NOT_LIST", "path": ["nodes"], "action": "replaced with an empty list"},
        {"code": "COLLECTION_NOT_LIST", "path": ["edges"], "action": "replaced with an empty list"}
      ]
    },
    {
      "name": "missing collections become empty lists",
      "rule": "graph-structure",
      "flow": {"description": "kept"},
      "expected": {"description": "kept", "nodes": [], "edges": []},
      "fixes": [
        {"code": "COLLECTION_NOT_LIST", "path": ["nodes"], "action": "replaced with an empty list"},
        {"code": "COLLECTION_NOT_LIST", "path": ["edges"], "action": "replaced with an empty list"}
      ]
    },
    {
      "name": "non-object entries are dropped",
      "rule": "graph-structure",
      "flow": {"nodes": [{"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}}, 1], "edges": ["x"]},
      "expected": {"nodes": [{"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}}], "edges": []},
      "fixes": [
        {"code": "NODE_NOT_OBJECT", "path": ["nodes", 1], "action": "dropped the entry"},
        {"code": "EDGE_NOT_OBJECT", "path": ["edges", 0], "action": "dropped the entry"}
      ]
    },
    {
      "name": "missing node objects become empty objects",
      "rule": "node-objects",
      "flow": {"nodes": [{"id": "a"}, {"id": "b", "data": {"node": {"template": null}}}], "edges": []},
      "expected": {"nodes": [{"id": "a", "data": {"node": {"template": {}}}}, {"id": "b", "data": {"node": {"template": {}}}}], "edges": []},
      "fixes": [
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 0, "data"], "action": "replaced with an empty object"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 0, "data", "node"], "action": "replaced with an empty object"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 0, "data", "node", "template"], "action": "replaced with an empty object"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 1, "data", "node", "template"], "action": "replaced with an empty object"}
      ]
    },
    {
      "name": "a missing node id gets a generated id in the editor shape",
      "rule": "graph-structure",
      "flow": {"nodes": [{"data": {"id": null, "type": "Prompt", "node": {"template": {}}}}], "edges": []},
      "expected": {"nodes": [{"data": {"id": "Prompt-IVF1k", "type": "Prompt", "node": {"template": {}}}, "id": "Prompt-IVF1k"}], "edges": []},
      "fixes": [{"code": "NODE_ID_MISSING", "path": ["nodes", 0, "id"], "action": "assigned a generated id"}]
    },
    {
      "name": "duplicate node ids keep the first node and its edges",
      "rule": "graph-structure",
      "flow": {
        "nodes": [
          {"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}},
          {"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}, "position": {"x": 1}},
          {"id": "b", "data": {"id": "b", "type": "Prompt", "node": {"template": {}}}}
        ],
        "edges": [{"id": "e", "source": "a", "target": "b", "sourceHandle": "S", "targetHandle": "T"}]
      },
      "expected": {
        "nodes": [
          {"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}},
          {"id": "Prompt-lTJOZ", "data": {"id": "Prompt-lTJOZ", "type": "Prompt", "node": {"template": {}}}, "position": {"x": 1}},
          {"id": "b", "data": {"id": "b", "type": "Prompt", "node": {"template": {}}}}
        ],
        "edges": [{"id": "e", "source": "a", "target": "b", "sourceHandle": "S", "targetHandle": "T"}]
      },
      "fixes": [{"code": "NODE_ID_DUPLICATE", "path": ["nodes", 1, "id"], "action": "assigned a generated id; the first node keeps the id and its edges"}]
    },
    {
      "name": "a node id that is not a string gets a generated id",
      "rule": "graph-structure",
      "flow": {"nodes": [{"id": 3, "data": {"id": 3, "node": {"template": {}}}}], "edges": []},
      "expected": {"nodes": [{"id": "node-wtFXP", "data": {"id": "node-wtFXP", "node": {"template": {}}}}], "edges": []},
      "fixes": [{"code": "NODE_ID_MISSING", "path": ["nodes", 0, "id"], "action": "assigned a generated id"}]
    },
    {
      "name": "edges to unknown nodes are dropped",
      "rule": "graph-structure",
      "flow": {
        "nodes": [{"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}}],
        "edges": [{"id": "e1", "source": "a", "target": "zz", "sourceHandle": "S", "targetHandle": "T"}, {"id": "e2", "target": "a"}]
      },
      "expected": {"nodes": [{"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}}], "edges": []},
      "fixes": [
        {"code": "EDGE_ENDPOINT_INVALID", "path": ["edges", 0, "target"], "action": "dropped the edge"},
        {"code": "EDGE_ENDPOINT_INVALID", "path": ["edges", 1, "source"], "action": "dropped the edge"}
      ]
    },
    {
      "name": "missing and duplicate edge ids are opaque like the editor",
      "rule": "graph-structure",
      "flow": {
        "nodes": [
          {"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}},
          {"id": "b", "data": {"id": "b", "type": "Prompt", "node": {"template": {}}}}
        ],
        "edges": [
          {"id": "e", "source": "a", "target": "b", "sourceHandle": "S", "targetHandle": "T"},
          {"id": "e", "source": "b", "target": "a", "sourceHandle": "S", "targetHandle": "T"},
          {"source": "a", "target": "b", "sourceHandle": "S", "targetHandle": "T"}
        ]
      },
      "expected": {
        "nodes": [
          {"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}},
          {"id": "b", "data": {"id": "b", "type": "Prompt", "node": {"template": {}}}}
        ],
        "edges": [
          {"id": "e", "source": "a", "target": "b", "sourceHandle": "S", "targetHandle": "T"},
          {"id": "<generated edge id>", "source": "b", "target": "a", "sourceHandle": "S", "targetHandle": "T"},
          {"source": "a", "target": "b", "sourceHandle": "S", "targetHandle": "T", "id": "<generated edge id>"}
        ]
      },
      "fixes": [
        {"code": "EDGE_ID_DUPLICATE", "path": ["edges", 1, "id"], "action": "assigned a generated id"},
        {"code": "EDGE_ID_MISSING", "path": ["edges", 2, "id"], "action": "assigned a generated id"}
      ]
    },
    {
      "name": "non-finite numbers become null",
      "rule": "finite-numbers",
      "flow_json": "{\"nodes\": [{\"id\": \"a\", \"data\": {\"id\": \"a\", \"type\": \"Prompt\", \"node\": {\"template\": {}}}, \"position\": {\"x\": 1e400, \"y\": 1}}], \"edges\": [], \"zoom\": -1e400}",
      "expected": {
        "nodes": [{"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}, "position": {"x": null, "y": 1}}],
        "edges": [],
        "zoom": null
      },
      "fixes": [
        {"code": "NON_FINITE_NUMBER", "path": ["zoom"], "action": "replaced with null"},
        {"code": "NON_FINITE_NUMBER", "path": ["nodes", 0, "position", "x"], "action": "replaced with null"}
      ]
    },
    {
      "name": "an integer too large for a double becomes null",
      "rule": "finite-numbers",
      "flow_json": "{\"nodes\": [{\"id\": \"a\", \"data\": {\"id\": \"a\", \"type\": \"Prompt\", \"node\": {\"template\": {}}}, \"position\": {\"x\": , \"y\": 9007199254740993}}], \"edges\": []}",
      "expected": {
        "nodes": [{"id": "a", "data": {"id": "a", "type": "Prompt", "node": {"template": {}}}, "position": {"x": null, "y": 9007199254740993}}],
        "edges": []
      },
      "fixes": [{"code": "NON_FINITE_NUMBER", "path": ["nodes", 0, "position", "x"], "action": "replaced with null"}]
    },
    {
      "name": "non-finite numbers in nested containers are found containers last first",
      "rule": "finite-numbers",
      "flow_json": "{\"nodes\": [], \"edges\": [], \"a\": [1e400, {\"b\": -1e400}], \"c\": {\"d\": [1e400], \"e\": 1e400}, \"f\": 1e400}",
      "expected": {"nodes": [], "edges": [], "a": [null, {"b": null}], "c": {"d": [null], "e": null}, "f": null},
      "fixes": [
        {"code": "NON_FINITE_NUMBER", "path": ["f"], "action": "replaced with null"},
        {"code": "NON_FINITE_NUMBER", "path": ["c", "e"], "action": "replaced with null"},
        {"code": "NON_FINITE_NUMBER", "path": ["c", "d", 0], "action": "replaced with null"},
        {"code": "NON_FINITE_NUMBER", "path": ["a", 0], "action": "replaced with null"},
        {"code": "NON_FINITE_NUMBER", "path": ["a", 1, "b"], "action": "replaced with null"}
      ]
    },
    {
      "name": "a badly broken graph comes out following every rule",
      "rule": "repair-direct-only",
      "flow_json": "{\"nodes\": [null, {\"id\": 3}, {\"id\": \"a\", \"data\": []}, {\"id\": \"a\"}, {\"data\": {\"node\": {\"template\": 1}}}], \"edges\": [{\"id\": \"e\"}, {\"id\": \"e\", \"source\": \"a\", \"target\": \"a\", \"w\": 1e400}, 7]}",
      "expected": {
        "nodes": [
          {"id": "node-YVbaX", "data": {"node": {"template": {}}, "id": "node-YVbaX"}},
          {"id": "a", "data": {"node": {"template": {}}}},
          {"id": "node-T6TMo", "data": {"node": {"template": {}}, "id": "node-T6TMo"}},
          {"data": {"node": {"template": {}}, "id": "node-XHBqP"}, "id": "node-XHBqP"}
        ],
        "edges": [{"id": "e", "source": "a", "target": "a", "w": null}]
      },
      "fixes": [
        {"code": "NON_FINITE_NUMBER", "path": ["edges", 1, "w"], "action": "replaced with null"},
        {"code": "NODE_NOT_OBJECT", "path": ["nodes", 0], "action": "dropped the entry"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 1, "data"], "action": "replaced with an empty object"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 1, "data", "node"], "action": "replaced with an empty object"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 1, "data", "node", "template"], "action": "replaced with an empty object"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 2, "data"], "action": "replaced with an empty object"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 2, "data", "node"], "action": "replaced with an empty object"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 2, "data", "node", "template"], "action": "replaced with an empty object"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 3, "data"], "action": "replaced with an empty object"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 3, "data", "node"], "action": "replaced with an empty object"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 3, "data", "node", "template"], "action": "replaced with an empty object"},
        {"code": "NODE_DATA_NOT_OBJECT", "path": ["nodes", 4, "data", "node", "template"], "action": "replaced with an empty object"},
        {"code": "NODE_ID_MISSING", "path": ["nodes", 1, "id"], "action": "assigned a generated id"},
        {"code": "NODE_ID_DUPLICATE", "path": ["nodes", 3, "id"], "action": "assigned a generated id; the first node keeps the id and its edges"},
        {"code": "NODE_ID_MISSING", "path": ["nodes", 4, "id"], "action": "assigned a generated id"},
        {"code": "EDGE_ENDPOINT_INVALID", "path": ["edges", 0, "source"], "action": "dropped the edge"},
        {"code": "EDGE_NOT_OBJECT", "path": ["edges", 2], "action": "dropped the entry"}
      ]
    },
