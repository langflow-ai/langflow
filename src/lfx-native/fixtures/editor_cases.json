{
  "description": "The editor's side of table rows and restore fixes. Expected outputs come from the editor's engine at ad19da0df4 (oplog-history-ui). `assign` gives rows the ids and positions the editor writes (withTableRowIds): unlike the server, it renumbers a table 1..n in stored order when a gap has no room left. `append` adds rows after a table (appendTableRows). `assign_nodes` gives row ids to the tables nodes add or change against the same nodes as they were (withNodesTableRowIds). `edge_fixes` turns a revision's edges as read into the edges its preview shows (edgeFixes); `fixes_for_edges` keeps the fixes of the flagged edges (fixesForEdges). Random row ids appear as `<generated row id>`; positions compare by value.",
  "assign": [
    {
      "name": "rows that have ids and positions are left as they are",
      "rows": [{"_id": "r1", "_pos": 1, "key": "Accept", "value": "json"}, {"_id": "r2", "_pos": 2, "key": "Auth", "value": "token"}],
      "expected": [{"_id": "r1", "_pos": 1, "key": "Accept", "value": "json"}, {"_id": "r2", "_pos": 2, "key": "Auth", "value": "token"}]
    },
    {
      "name": "new rows get random ids and positions in order",
      "rows": [{"key": "Accept", "value": "json"}, {"key": "Auth", "value": "token"}],
      "expected": [
        {"key": "Accept", "value": "json", "_id": "<generated row id>", "_pos": 1},
        {"key": "Auth", "value": "token", "_id": "<generated row id>", "_pos": 2}
      ]
    },
    {
      "name": "a row equal to a previous row takes its id and position",
      "rows": [{"key": "Accept", "value": "json"}, {"key": "Auth", "value": "token"}],
      "previous": [{"_id": "r1", "_pos": 1, "key": "Accept", "value": "json"}, {"_id": "r2", "_pos": 2, "key": "Auth", "value": "token"}],
      "expected": [{"key": "Accept", "value": "json", "_pos": 1, "_id": "r1"}, {"key": "Auth", "value": "token", "_pos": 2, "_id": "r2"}]
    },
    {
      "name": "a run between two positions is spread evenly",
      "rows": [{"_id": "a", "_pos": 1}, {"k": 1}, {"k": 2}, {"_id": "b", "_pos": 2}],
      "expected": [
        {"_id": "a", "_pos": 1},
        {"k": 1, "_id": "<generated row id>", "_pos": 1.3333333333333333},
        {"k": 2, "_id": "<generated row id>", "_pos": 1.6666666666666665},
        {"_id": "b", "_pos": 2}
      ]
    },
    {
      "name": "a gap with no room left renumbers the table in stored order",
      "rows": [{"_id": "a", "_pos": 1}, {"k": 1}, {"_id": "b", "_pos": 1.0000000000000002}],
      "expected": [{"_id": "a", "_pos": 1}, {"k": 1, "_id": "<generated row id>", "_pos": 2}, {"_id": "b", "_pos": 3}]
    },
    {
      "name": "a run before the first position counts down",
      "rows": [{"k": 1}, {"k": 2}, {"_id": "a", "_pos": 10}],
      "expected": [{"k": 1, "_id": "<generated row id>", "_pos": 8}, {"k": 2, "_id": "<generated row id>", "_pos": 9}, {"_id": "a", "_pos": 10}]
    },
    {
      "name": "a run between out-of-order neighbours follows the one before",
      "rows": [{"_id": "a", "_pos": 3}, {"k": 1}, {"_id": "b", "_pos": 1}],
      "expected": [{"_id": "a", "_pos": 3}, {"k": 1, "_id": "<generated row id>", "_pos": 4}, {"_id": "b", "_pos": 1}]
    },
    {
      "name": "a duplicate id is replaced",
      "rows": [{"_id": "a", "_pos": 1}, {"_id": "a", "_pos": 2}],
      "expected": [{"_id": "a", "_pos": 1}, {"_id": "<generated row id>", "_pos": 2}]
    },
    {
      "name": "a table with a row that is not an object is left alone",
      "rows": [{"key": "Accept", "value": "json"}, "x"],
      "expected": [{"key": "Accept", "value": "json"}, "x"]
    }
  ],
  "append": [
    {
      "name": "rows are appended one past the last position",
      "rows": [{"_id": "r1", "_pos": 1, "key": "Accept", "value": "json"}, {"_id": "r2", "_pos": 2, "key": "Auth", "value": "token"}],
      "new_rows": [{"key": "New", "value": "x"}],
      "expected": [
        {"_id": "r1", "_pos": 1, "key": "Accept", "value": "json"},
        {"_id": "r2", "_pos": 2, "key": "Auth", "value": "token"},
        {"key": "New", "value": "x", "_id": "<generated row id>", "_pos": 3}
      ]
    },
    {
      "name": "a duplicated row gets a new id and position",
      "rows": [{"_id": "r1", "_pos": 1, "key": "Accept", "value": "json"}, {"_id": "r2", "_pos": 2, "key": "Auth", "value": "token"}],
      "new_rows": [{"_id": "r1", "_pos": 1, "key": "Accept", "value": "json"}, {"_id": "r2", "_pos": 2, "key": "Auth", "value": "token"}],
      "expected": [
        {"_id": "r1", "_pos": 1, "key": "Accept", "value": "json"},
        {"_id": "r2", "_pos": 2, "key": "Auth", "value": "token"},
        {"key": "Accept", "value": "json", "_id": "<generated row id>", "_pos": 3},
        {"key": "Auth", "value": "token", "_id": "<generated row id>", "_pos": 4}
      ]
    },
    {
      "name": "the next position follows a fractional last position",
      "rows": [{"_id": "a", "_pos": 2.5}],
      "new_rows": [{"k": 1}, {"k": 2}],
      "expected": [{"_id": "a", "_pos": 2.5}, {"k": 1, "_id": "<generated row id>", "_pos": 3}, {"k": 2, "_id": "<generated row id>", "_pos": 4}]
    },
    {
      "name": "a table without ids gets them first",
      "rows": [{"key": "Accept", "value": "json"}, {"key": "Auth", "value": "token"}],
      "new_rows": [{"key": "New"}],
      "expected": [
        {"key": "Accept", "value": "json", "_id": "<generated row id>", "_pos": 1},
        {"key": "Auth", "value": "token", "_id": "<generated row id>", "_pos": 2},
        {"key": "New", "_id": "<generated row id>", "_pos": 3}
      ]
    },
    {
      "name": "the first row of an empty table is 1",
      "rows": [],
      "new_rows": [{"key": "New"}],
      "expected": [{"key": "New", "_id": "<generated row id>", "_pos": 1}]
    }
  ],
