          {"id": "e", "source": "a", "target": "b", "sourceHandle": "{œidœ:œaœ,œnameœ:œoutœ}", "targetHandle": "{œfieldNameœ:œfœ,œidœ:œbœ,œtypeœ:œstrœ}"}
        ]
      },
      "target": {
        "nodes": [
          {"id": "a", "data": {"node": {"template": {}, "outputs": [{"name": "out"}]}}},
          {"id": "b", "data": {"node": {"template": {"f": {"type": "str", "value": ""}}}}}
        ],
        "edges": [
          {"id": "e", "source": "a", "target": "b", "sourceHandle": "{œidœ: œaœ, œnameœ: œoutœ}", "targetHandle": "{œtypeœ:œstrœ,œidœ:œbœ,œfieldNameœ:œfœ}"}
        ]
      },
      "operations": []
    },
