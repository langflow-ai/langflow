{
  "description": "Shared diff cases. diff_flow_data(base, target) must return exactly `operations`, and applying them to `base` must give `target` under canonical equality. Units, keyed lists and view state follow node_schema.json: every top-level key other than `nodes` and `edges` is view state. Each case names the rule it checks in `rule`; README.md lists the rules. The expected outputs are reviewed data that every engine must meet.",
  "cases": [
    {
      "name": "no change",
      "rule": "records-only-changes",
      "base": {
        "nodes": [
          {"id": "a", "data": {"node": {"template": {}, "outputs": [{"name": "out"}]}}},
          {"id": "b", "data": {"node": {"template": {"f": {"type": "str", "value": ""}}}}}
        ],
        "edges": [{"id": "e", "source": "a", "target": "b"}]
      },
      "target": {
        "nodes": [
          {"id": "a", "data": {"node": {"template": {}, "outputs": [{"name": "out"}]}}},
          {"id": "b", "data": {"node": {"template": {"f": {"type": "str", "value": ""}}}}}
        ],
        "edges": [{"id": "e", "source": "a", "target": "b"}]
      },
      "operations": []
    },
    {
      "name": "view state is never diffed",
      "rule": "view-state",
      "base": {
        "nodes": [
          {"id": "a", "data": {"node": {"template": {}, "outputs": [{"name": "out"}]}}},
          {"id": "b", "data": {"node": {"template": {"f": {"type": "str", "value": ""}}}}}
        ],
        "edges": [{"id": "e", "source": "a", "target": "b"}]
      },
      "target": {
        "nodes": [
          {"id": "a", "data": {"node": {"template": {}, "outputs": [{"name": "out"}]}}},
          {
            "id": "b",
            "data": {
              "node": {
                "template": {"f": {"type": "str", "value": "", "display_name": "F", "info": "help", "options": ["a"]}, "_frontend_node_flow_id": {"value": "x"}},
                "last_updated": "now",
                "lf_version": "1.14"
              }
            },
            "selected": true,
            "measured": {"width": 1},
            "width": 3,
            "height": 4
          }
        ],
        "edges": [{"id": "e", "source": "a", "target": "b", "selected": true, "animated": true}],
        "viewport": {"zoom": 2}
      },
      "operations": []
    },
    {
