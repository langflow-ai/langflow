# Type stubs for the native part of lfx_native.
#
# An argument that is `bytes` is UTF-8 JSON text. Any other argument is the
# JSON value itself: dict, list, tuple, str, int, float, bool or None. A `str`
# is a JSON string, never text to parse. Results are Python values.

from typing import Any, Literal, TypeAlias

Json: TypeAlias = bytes | dict[str, Any] | list[Any] | tuple[Any, ...] | str | int | float | bool | None
JsonObject: TypeAlias = dict[str, Any]
JsonList: TypeAlias = list[Any]

class EngineError(Exception):
    kind: str
    code: str
    details: JsonObject

class GraphPlain:
    def __init__(self, flow: Json) -> None: ...
    def validate(self, base: GraphPlain | None = None, *, check_values: bool = True) -> JsonList: ...
    def repair(self, base: GraphPlain | None = None) -> tuple[GraphPlain, JsonList]: ...
    def graph_hash(self) -> str: ...
    def equals(self, other: GraphPlain) -> bool: ...
    def ops_diff(self, target: GraphPlain) -> JsonList: ...
    def to_json(self) -> str: ...
    def to_dict(self) -> JsonObject: ...

class GraphState:
    def __init__(self, flow: Json | GraphPlain) -> None: ...
    def apply(
        self,
        operations: Json,
        *,
        forward: bool = False,
        backward: bool = False,
        mode: Literal["strict", "preview"] = "strict",
    ) -> JsonObject: ...
    def to_json(self) -> str: ...
    def to_dict(self) -> JsonObject: ...

def apply(
    flow: Json,
    operations: Json,
    *,
    forward: bool = True,
    backward: bool = False,
    mode: Literal["strict", "preview"] = "strict",
) -> JsonObject: ...
def ops_diff(base: Json, target: Json) -> JsonList: ...
def validate(flow: Json, base: Json | None = None, *, check_values: bool = True) -> JsonList: ...
def repair(flow: Json, base: Json | None = None) -> JsonObject: ...
def graph_hash(flow: Json) -> str: ...
def graphs_equal(left: Json, right: Json) -> bool: ...
def values_equal(left: Json, right: Json) -> bool: ...
def canonical_json(value: Json) -> str: ...
def apply_restore_fixes(revision: Json, stored: Json, fixes: Json) -> JsonObject: ...
def edge_fixes(read: Json, shown: Json) -> JsonList: ...
def fixes_for_edges(fixes: Json, edge_ids: Json) -> JsonList: ...
def ordered_rows(rows: Json) -> JsonList: ...
def strip_row_keys(rows: Json) -> JsonList: ...
def strip_flow_table_row_keys(flow: Json) -> JsonObject: ...
def assign_row_ids(rows: Json, previous: Json | None = None, *, editor: bool = False) -> JsonList: ...
def assign_table_row_ids(node: Json, *, editor: bool = False) -> JsonObject: ...
def assign_changed_table_row_ids(base: Json, target: Json, *, editor: bool = False) -> JsonObject: ...
def assign_changed_node_table_row_ids(
    node: Json, previous: Json | None = None, *, editor: bool = False
) -> JsonObject: ...
def append_table_rows(rows: Json, new_rows: Json) -> JsonList: ...
def table_fields(node: Json) -> JsonList: ...
def new_edge_id() -> str: ...
def new_table_row_id() -> str: ...
def node_schema() -> str: ...
