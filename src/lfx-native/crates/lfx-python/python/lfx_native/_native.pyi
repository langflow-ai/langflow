# Type stubs for the native part of lfx_native. Every Json value is JSON text.

from typing import TypeAlias

Json: TypeAlias = str | bytes

class EngineError(Exception):
    kind: str
    code: str
    details: str

class GraphState:
    def __init__(self, flow: Json) -> None: ...
    def apply(
        self,
        operations: Json,
        *,
        forward: bool = False,
        inverse: bool = False,
        restoring: bool = False,
    ) -> str: ...
    def to_json(self) -> str: ...

def apply(
    flow: Json,
    operations: Json,
    *,
    forward: bool = True,
    inverse: bool = False,
    restoring: bool = False,
) -> str: ...
def normalize_operations(operations: Json) -> str: ...
def diff(base: Json, target: Json) -> str: ...
def derive(base: Json, target: Json) -> str: ...
def validate(flow: Json, base: Json | None = None, *, check_values: bool = True) -> str: ...
def repair(flow: Json, base: Json | None = None) -> str: ...
def graph_hash(flow: Json) -> str: ...
def graphs_equal(left: Json, right: Json) -> bool: ...
def values_equal(left: Json, right: Json) -> bool: ...
def canonical_json(value: Json) -> str: ...
def prepare_write(stored: Json, target: Json, options: Json) -> str: ...
def apply_restore_fixes(revision: Json, stored: Json, fixes: Json) -> str: ...
def edge_fixes(read: Json, shown: Json) -> str: ...
def fixes_for_edges(fixes: Json, edge_ids: Json) -> str: ...
def ordered_rows(rows: Json) -> str: ...
def strip_row_keys(rows: Json) -> str: ...
def strip_flow_table_row_keys(flow: Json) -> str: ...
def assign_row_ids(rows: Json, previous: Json | None = None, *, editor: bool = False) -> str: ...
def assign_table_row_ids(node: Json, *, editor: bool = False) -> str: ...
def assign_changed_table_row_ids(base: Json, target: Json, *, editor: bool = False) -> str: ...
def assign_changed_node_table_row_ids(node: Json, previous: Json | None = None, *, editor: bool = False) -> str: ...
def append_table_rows(rows: Json, new_rows: Json) -> str: ...
def table_fields(node: Json) -> str: ...
def new_edge_id() -> str: ...
def new_table_row_id() -> str: ...
def node_schema() -> str: ...
