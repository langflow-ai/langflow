{
  "schema_version": "1",
  "id": "kb_ingest_kb_retrieve",
  "test_type": "load",
  "purpose": "Measure vector-store write vs read contention on the same knowledge base.",
  "movement_kind": "axis_set",
  "stress_categories": [
    "kb_ingest",
    "kb_retrieve"
  ],
  "protocols": [
    "workflows_sync"
  ],
  "modes": [
    "sync"
  ],
  "flow_selectors": [
    "perf_kb_ingest",
    "perf_kb_retrieve"
  ],
  "dataset_selectors": [
    "kb/bounded_corpus"
  ],
  "workload": {
    "workload_model": "closed",
    "user_mix": [
      {
        "user_class": "KbIngestUser",
        "weight": 1,
        "count": 1
      },
      {
        "user_class": "KbRetrieveUser",
        "weight": 1,
        "count": 1
      }
    ],
    "think_time": {
      "min_s": 0.5,
      "max_s": 1.5
    }
  },
  "windows": {
    "warm_up": {
      "duration_s": 5,
      "users": 0
    },
    "measured_steps": [
      {
        "users": 2,
        "duration_s": 30,
        "spawn_rate": 1
      }
    ],
    "drain": {
      "deadline_s": 45
    },
    "sampling_interval_s": 5,
    "poll_interval_s": 1
  },
  "safety_limits": {
    "provider_spend_usd": 0,
    "backlog_max": 30,
    "storage_growth_bytes": 52428800,
    "error_storm_rate": 0.25,
    "drain_timeout_s": 90,
    "cleanup_timeout_s": 120
  },
  "reset_rules": {
    "reset_kb_corpus": true
  }
}
