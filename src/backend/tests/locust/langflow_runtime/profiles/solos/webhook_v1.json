{
  "schema_version": "1",
  "id": "webhook_v1",
  "test_type": "load",
  "purpose": "Stress webhook accept/complete lifecycle with paced arrivals.",
  "movement_kind": "solo",
  "stress_categories": ["webhook"],
  "protocols": ["webhook"],
  "modes": ["webhook"],
  "flow_selectors": ["perf_webhook_passthrough"],
  "dataset_selectors": ["webhook/default_payload"],
  "workload": {
    "workload_model": "paced_closed",
    "arrival_rate_per_s": 0.5,
    "user_mix": [{"user_class": "WebhookUser", "weight": 1, "count": 1}],
    "think_time": {"min_s": 0.5, "max_s": 1.0}
  },
  "windows": {
    "warm_up": {"duration_s": 5, "users": 0},
    "measured_steps": [{"arrival_rate_per_s": 0.5, "duration_s": 30, "spawn_rate": 1}],
    "drain": {"deadline_s": 30},
    "sampling_interval_s": 5,
    "poll_interval_s": 1
  },
  "safety_limits": {
    "provider_spend_usd": 0,
    "backlog_max": 20,
    "storage_growth_bytes": 1048576,
    "error_storm_rate": 0.25,
    "drain_timeout_s": 60,
    "cleanup_timeout_s": 120
  },
  "validity": {"max_generator_cpu_pct": 85, "allowed_scheduling_lateness_s": 3, "cold_warm": "either"},
  "reset_rules": {"reset_webhook_subscriptions": true}
}
