{
  "schema_version": "1",
  "id": "queue",
  "test_type": "load",
  "purpose": "Stress background queue admission and completion with paced arrivals.",
  "movement_kind": "axis_set",
  "stress_categories": [
    "queue"
  ],
  "protocols": [
    "workflows_background"
  ],
  "modes": [
    "background"
  ],
  "flow_selectors": [
    "perf_queue_short"
  ],
  "dataset_selectors": [],
  "workload": {
    "workload_model": "paced_closed",
    "arrival_rate_per_s": 1.0,
    "user_mix": [
      {
        "user_class": "QueueUser",
        "weight": 1,
        "count": 2
      }
    ],
    "think_time": {
      "min_s": 0.2,
      "max_s": 0.5
    }
  },
  "windows": {
    "warm_up": {
      "duration_s": 5,
      "users": 0
    },
    "measured_steps": [
      {
        "arrival_rate_per_s": 1.0,
        "duration_s": 30,
        "spawn_rate": 1
      }
    ],
    "drain": {
      "deadline_s": 30
    },
    "sampling_interval_s": 5,
    "poll_interval_s": 1
  },
  "safety_limits": {
    "provider_spend_usd": 0,
    "backlog_max": 50,
    "storage_growth_bytes": 1048576,
    "error_storm_rate": 0.25,
    "drain_timeout_s": 60,
    "cleanup_timeout_s": 120
  },
  "reset_rules": {}
}
