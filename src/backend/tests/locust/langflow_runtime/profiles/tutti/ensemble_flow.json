{
  "schema_version": "1",
  "id": "ensemble_flow",
  "test_type": "load",
  "purpose": "Stress the full ensemble journey flow across workflows, MCP, and webhooks.",
  "movement_kind": "tutti",
  "stress_categories": [
    "ensemble_flow"
  ],
  "protocols": [
    "mcp",
    "workflows_sync",
    "workflows_background",
    "webhook"
  ],
  "modes": [
    "sync",
    "background",
    "webhook"
  ],
  "flow_selectors": [
    "perf_ensemble_journey",
    "perf_passthrough",
    "perf_webhook_passthrough"
  ],
  "dataset_selectors": [
    "kb/bounded_corpus",
    "storage/bounded_payload",
    "webhook/default_payload"
  ],
  "workload": {
    "workload_model": "closed",
    "user_mix": [
      {
        "user_class": "EnsembleFlowUser",
        "weight": 1,
        "count": 1
      }
    ],
    "think_time": {
      "min_s": 1.0,
      "max_s": 2.0
    }
  },
  "windows": {
    "warm_up": {
      "duration_s": 10,
      "users": 0
    },
    "measured_steps": [
      {
        "users": 1,
        "duration_s": 60,
        "spawn_rate": 1
      }
    ],
    "drain": {
      "deadline_s": 90
    },
    "sampling_interval_s": 5,
    "poll_interval_s": 1
  },
  "safety_limits": {
    "provider_spend_usd": 2.0,
    "backlog_max": 20,
    "storage_growth_bytes": 104857600,
    "error_storm_rate": 0.25,
    "drain_timeout_s": 120,
    "cleanup_timeout_s": 180
  },
  "validity": {
    "max_generator_cpu_pct": 90,
    "allowed_scheduling_lateness_s": 5,
    "cold_warm": "either"
  },
  "reset_rules": {
    "reset_kb_corpus": true,
    "reset_storage_artifacts": true,
    "reset_webhook_subscriptions": true
  }
}
