{
  "schema_version": "1",
  "id": "ensemble_suite",
  "test_type": "capacity",
  "purpose": "Concurrent sweep across representative solo stress categories as separate user classes.",
  "movement_kind": "tutti",
  "stress_categories": [
    "ensemble_suite",
    "protocol_calibration",
    "chat_db",
    "queue",
    "kb_retrieve"
  ],
  "protocols": [
    "mcp",
    "workflows_sync",
    "workflows_background"
  ],
  "modes": [
    "sync",
    "background"
  ],
  "flow_selectors": [
    "perf_passthrough",
    "MemoryChatbotNoLLM",
    "perf_queue_short",
    "perf_kb_retrieve"
  ],
  "dataset_selectors": [
    "kb/bounded_corpus"
  ],
  "workload": {
    "workload_model": "closed",
    "user_mix": [
      {
        "user_class": "ProtocolCalibrationUser",
        "weight": 1,
        "count": 1
      },
      {
        "user_class": "ChatDbUser",
        "weight": 1,
        "count": 1
      },
      {
        "user_class": "QueueUser",
        "weight": 1,
        "count": 1
      },
      {
        "user_class": "KbRetrieveUser",
        "weight": 1,
        "count": 1
      }
    ],
    "think_time": {
      "min_s": 0.5,
      "max_s": 1.0
    }
  },
  "windows": {
    "warm_up": {
      "duration_s": 10,
      "users": 0
    },
    "measured_steps": [
      {
        "users": 4,
        "duration_s": 60,
        "spawn_rate": 1
      }
    ],
    "drain": {
      "deadline_s": 60
    },
    "sampling_interval_s": 5,
    "poll_interval_s": 1
  },
  "safety_limits": {
    "provider_spend_usd": 0,
    "backlog_max": 50,
    "storage_growth_bytes": 52428800,
    "error_storm_rate": 0.25,
    "drain_timeout_s": 120,
    "cleanup_timeout_s": 180
  },
  "validity": {
    "max_generator_cpu_pct": 90,
    "allowed_scheduling_lateness_s": 5,
    "cold_warm": "either"
  },
  "reset_rules": {
    "reset_message_store": true,
    "reset_kb_corpus": false
  }
}
