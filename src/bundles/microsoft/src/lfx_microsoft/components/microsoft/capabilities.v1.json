      "auth_profile_id": "user",
      "identity": "user_delegated",
      "required_scopes": [
        "Mail.Send"
      ],
      "conditional_scopes": [],
      "policy_keys": [
        "integrations.microsoft.outlook.send"
      ],
      "substrate": "rest",
      "maturity": "ga",
      "deployment_contexts": [
        "hosted",
        "self_managed",
        "desktop",
        "headless"
      ],
      "risk": "write",
      "component_ref": "OutlookSendComponent"
    },
    {
