{
  "schema_version": 1,
  "provider_id": "google",
  "display_name": "Google Workspace",
  "icon": "Google",
  "docs_url": "https://docs.langflow.org/bundles-google",
  "auth_profiles": [
    {
      "id": "user",
      "kind": "oauth2_authorization_code",
