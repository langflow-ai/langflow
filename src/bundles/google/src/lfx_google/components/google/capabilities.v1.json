      "supports_pkce": true,
      "supports_refresh": true,
      "scope_separator": " ",
      "default_scopes": [],
      "client_type_by_context": {
        "hosted": "confidential",
        "self_managed": "confidential",
        "desktop": "public",
        "headless": "external"
