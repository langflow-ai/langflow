      "identity": "user_delegated",
      "required_scopes": [
        "read:page:confluence",
        "read:confluence-user"
      ],
      "policy_keys": [
        "integrations.confluence.page.search"
      ],
      "substrate": "rest",
      "maturity": "preview",
      "deployment_contexts": [
        "hosted",
        "self_managed"
      ],
      "risk": "read",
      "component_ref": "ConfluenceSearchPagesComponent"
    },
