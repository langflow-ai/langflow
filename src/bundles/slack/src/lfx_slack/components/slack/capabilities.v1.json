{
  "schema_version": 1,
  "provider_id": "slack",
  "display_name": "Slack",
  "icon": "Slack",
  "docs_url": "https://docs.langflow.org/bundles-slack",
  "auth_profiles": [
    {
      "id": "slack-user-oauth",
      "kind": "oauth2_authorization_code",
      "identity": "user_delegated",
      "authorization_url": "https://slack.com/oauth/v2/authorize",
      "token_url": "https://slack.com/api/oauth.v2.access",
      "supports_pkce": true,
      "supports_refresh": true,
      "scope_separator": ",",
      "default_scopes": [],
      "client_type_by_context": {
        "hosted": "confidential",
        "self_managed": "confidential",
        "desktop": "public",
        "headless": "external"
      },
      "owner_by_context": {
        "hosted": "langflow",
        "self_managed": "customer",
        "desktop": "langflow",
        "headless": "customer"
      }
    },
    {
      "id": "slack-bot-install",
      "kind": "bot_token_install",
      "identity": "bot",
      "authorization_url": "https://slack.com/oauth/v2/authorize",
      "token_url": "https://slack.com/api/oauth.v2.access",
      "supports_pkce": false,
      "supports_refresh": true,
      "scope_separator": ",",
      "default_scopes": [],
      "client_type_by_context": {
        "hosted": "confidential",
