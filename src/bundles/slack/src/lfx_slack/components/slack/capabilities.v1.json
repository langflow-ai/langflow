      "display_name": "Slack: List Channel Members (as app)",
      "auth_profile_id": "slack-bot-install",
      "identity": "bot",
      "required_scopes": [
        "channels:read"
      ],
      "conditional_scopes": [
        {
          "scope": "groups:read",
          "role": "optional",
          "condition": {
            "kind": "input_truthy",
