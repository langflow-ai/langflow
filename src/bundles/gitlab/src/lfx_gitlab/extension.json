{
  "$schema": "https://schemas.langflow.org/extension/v1.json",
  "id": "lfx-gitlab",
  "version": "0.1.0",
  "name": "GitLab",
  "description": "GitLab project, issue, merge request and comment actions with signed project event triggers.",
  "lfx": {
    "compat": [
      "1"
    ]
  },
  "bundles": [
    {
      "name": "gitlab",
      "path": "components/gitlab"
    }
  ],
  "integrations": [
    {
      "provider_id": "gitlab",
      "bundle": "gitlab",
      "path": "capabilities.v1.json"
    }
  ]
}
