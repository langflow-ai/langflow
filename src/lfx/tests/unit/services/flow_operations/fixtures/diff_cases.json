{
  "description": "Shared diff cases. diff_flow_data(base, target) must return exactly `operations` (optional fields left unset are omitted), and applying them to `base` must give `target` under canonical equality. Units, keyed lists and view state follow node_schema.json.",
  "cases": [
    {
      "name": "no change",
      "base": {
        "nodes": [
          {"id": "a", "data": {"node": {"template": {}, "outputs": [{"name": "out"}]}}},
          {"id": "b", "data": {"node": {"template": {"f": {"type": "str", "value": ""}}}}}
        ],
        "edges": [{"id": "e", "source": "a", "target": "b"}]
      },
      "target": {
        "nodes": [
          {"id": "a", "data": {"node": {"template": {}, "outputs": [{"name": "out"}]}}},
          {"id": "b", "data": {"node": {"template": {"f": {"type": "str", "value": ""}}}}}
        ],
        "edges": [{"id": "e", "source": "a", "target": "b"}]
      },
      "operations": []
    },
    {
      "name": "view state is never diffed",
      "base": {
        "nodes": [
          {"id": "a", "data": {"node": {"template": {}, "outputs": [{"name": "out"}]}}},
          {"id": "b", "data": {"node": {"template": {"f": {"type": "str", "value": ""}}}}}
        ],
        "edges": [{"id": "e", "source": "a", "target": "b"}]
      },
      "target": {
        "nodes": [
          {"id": "a", "data": {"node": {"template": {}, "outputs": [{"name": "out"}]}}},
          {
            "id": "b",
            "data": {
              "node": {
                "template": {"f": {"type": "str", "value": "", "display_name": "F", "info": "help", "options": ["a"]}, "_frontend_node_flow_id": {"value": "x"}},
                "last_updated": "now",
                "lf_version": "1.14"
              }
            },
            "selected": true,
            "measured": {"width": 1},
            "width": 3,
            "height": 4
          }
        ],
        "edges": [{"id": "e", "source": "a", "target": "b", "selected": true, "animated": true}],
        "viewport": {"zoom": 2}
      },
      "operations": []
    },
    {
      "name": "two spellings of one handle are the same edge",
      "base": {
        "nodes": [
          {"id": "a", "data": {"node": {"template": {}, "outputs": [{"name": "out"}]}}},
          {"id": "b", "data": {"node": {"template": {"f": {"type": "str", "value": ""}}}}}
        ],
        "edges": [
          {"id": "e", "source": "a", "target": "b", "sourceHandle": "{œidœ:œaœ,œnameœ:œoutœ}", "targetHandle": "{œfieldNameœ:œfœ,œidœ:œbœ,œtypeœ:œstrœ}"}
        ]
      },
      "target": {
        "nodes": [
          {"id": "a", "data": {"node": {"template": {}, "outputs": [{"name": "out"}]}}},
