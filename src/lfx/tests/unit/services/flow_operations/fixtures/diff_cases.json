      "name": "a value edit writes the whole value unit",
      "base": {"nodes": [{"id": "n", "data": {"node": {"template": {"f": {"type": "str", "value": "a", "load_from_db": false}}}}}], "edges": []},
      "target": {"nodes": [{"id": "n", "data": {"node": {"template": {"f": {"type": "str", "value": "b", "load_from_db": false}}}}}], "edges": []},
      "operations": [
        {
          "type": "update_nodes",
          "updates": [
